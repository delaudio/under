{
  "name": "@delaudio/under",
  "version": "0.1.0",
  "description": "A flexible terminal IDE for Neovim, Yazi, Hunk and coding agents",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "visual": "bun scripts/visual.ts",
    "storybook:frames": "bun scripts/render-stories.ts",
    "storybook": "bun run storybook:frames && storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build-storybook": "bun run storybook:frames && storybook build --disable-telemetry",
    "typecheck:storybook": "bun run storybook:frames && tsc --noEmit -p storybook/tsconfig.json",
    "test:storybook": "bun run build-storybook && playwright test",
    "test:storybook:visual": "bun run test:storybook",
    "test:storybook:visual:update": "bun run build-storybook && playwright test --update-snapshots=all"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@opentui/core": "0.6.1",
    "smol-toml": "1.6.0",
    "string-width": "7.2.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.57.0",
    "@storybook/html-vite": "10.3.6",
    "@types/bun": "1.3.11",
    "playwright": "1.57.0",
    "prettier": "3.6.2",
    "storybook": "10.3.6",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
